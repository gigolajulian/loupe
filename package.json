{
  "name": "loupe",
  "productName": "LOUPE",
  "version": "0.3.4",
  "private": true,
  "description": "Top-of-screen island for Claude Code sessions",
  "author": "Julian Gigola",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "sh logo/export-icons.sh",
    "dist": "electron-builder --win nsis",
    "dist:mac": "sh mac/build.sh && electron-builder --mac",
    "release": "electron-builder --win nsis --publish always && node scripts/sign-release.js --upload",
    "test": "node --test && node sessions.js && node hooks.js"
  },
  "build": {
    "appId": "com.juliangigola.loupe",
    "productName": "LOUPE",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "update-signature.js",
      "pipe.js",
      "store.js",
      "ipc.js",
      "preload.js",
      "renderer.js",
      "sessions.js",
      "hooks.js",
      "uninstall.js",
      "relay.js",
      "reap/reap.ps1",
      "reap/allow.txt",
      "index.html",
      "icon.png",
      "icon@2x.png",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "package.json"
    ],
    "asarUnpack": [
      "reap/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "mac/bin/menubar",
          "to": "menubar"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "LOUPE",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "gigolajulian",
      "repo": "loupe",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8",
    "thinking-orbs": "^0.3.2"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "electron-winstaller@5.4.0": true,
    "koffi@3.3.3": true
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  }
}
